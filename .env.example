# Copy to .env — every value here has a working default, so this file is optional.

# --- Server (helena_server) -------------------------------------------------
# Where Ollama is listening.
HELENA_OLLAMA_HOST=http://127.0.0.1:11434
# Where the FastAPI server itself binds.
HELENA_HOST=127.0.0.1
HELENA_PORT=8080
# Default models. Any tool-calling-capable model works for chat
# (llama3.1, qwen2.5, qwen3, mistral-nemo, gpt-oss...).
HELENA_DEFAULT_MODEL=qwen2.5:7b-instruct
HELENA_VISION_MODEL=llava
HELENA_EMBED_MODEL=nomic-embed-text
# Context window. Ollama sizes its KV cache off this, so it is the single
# biggest lever on RAM usage. 8192 suits an agentic loop; drop to 4096 if tight.
HELENA_NUM_CTX=8192
# Max simultaneous generations forwarded to Ollama.
HELENA_MAX_CONCURRENCY=2
# Seconds to wait on a single generation.
HELENA_REQUEST_TIMEOUT=600
# Optional shared secret. If set, every /v1/* request needs
# `Authorization: Bearer <token>`. Unset means no auth (localhost only).
# HELENA_API_TOKEN=change-me
# Where conversation history is persisted (sqlite).
# HELENA_DB_PATH=~/.helena/helena.db

# --- Harness (helena_harness) ----------------------------------------------
# The server the terminal harness talks to.
HELENA_SERVER_URL=http://127.0.0.1:8080
# Chat model override (blank = whatever the server's default is).
# HELENA_MODEL=qwen2.5:7b-instruct
# Run subagents on something smaller/faster than the main model — often
# read-heavy work that doesn't need your biggest model.
# HELENA_SUBAGENT_MODEL=llama3.2:3b
# Permission mode: ask | auto | plan | yolo.
# HELENA_MODE=ask
# Let file tools (read_file/write_file/edit_file/etc.) reach outside the
# workspace directory. run_command could already do this via the shell —
# this extends the same trust to the structured tools. /trust sets this too.
# HELENA_ALLOW_OUTSIDE_WORKSPACE=false
# Cross-project memory: /remember (and HELENA noticing things on its own) is
# embedded and recalled by similarity search before every turn, across every
# project — see memory.py and the README's Configuration section.
# HELENA_MEMORY_ENABLED=true
# HELENA_MEMORY_TOP_K=5
# Which embedding model the harness asks the server for (blank = the
# server's own HELENA_EMBED_MODEL default, above).
# HELENA_EMBED_MODEL=nomic-embed-text

# --- Voice (optional — see the README's Voice section) ----------------------
# Speech-to-text (/voice) is local and free (faster-whisper), needs no key —
# just `pip install -e ".[voice]"`. Nothing below this line is required for
# that half.
#
# Text-to-speech (HELENA's spoken voice) uses ElevenLabs and needs your own
# account. Plain ELEVENLABS_API_KEY (no HELENA_ prefix) also works, so an
# existing key from other tools is picked up automatically.
# ELEVENLABS_API_KEY=your-key-here
# HELENA_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Auto-speak every reply once TTS is configured (or just use /say on demand).
# HELENA_SPEAK_REPLIES=false

# --- 3D printing (optional — see extras/print3d/README.md) ------------------
# generate_3d_model only needs the openscad CLI on PATH (brew install openscad);
# nothing below is required for that stage alone.
# HELENA_OPENSCAD_PATH=openscad
#
# slice_model needs a slicer CLI (OrcaSlicer or Bambu Studio) and a profile
# bundle exported once from that slicer's GUI (printer.json, filament.json,
# process.json in one folder).
# HELENA_SLICER_PATH=/Applications/OrcaSlicer.app/Contents/MacOS/OrcaSlicer
# HELENA_SLICER_PROFILE_DIR=~/.helena/bambu-a1-profile
#
# send_to_printer needs the A1 switched to LAN-only mode with Developer Mode
# enabled (Settings on the printer's touchscreen) — this trades away Bambu
# Handy remote monitoring and cloud print history for local write access.
# The access code shows on the printer's screen once Developer Mode is on;
# the serial is on the printer's sticker or in Bambu Studio's device panel.
# HELENA_BAMBU_IP=192.168.1.50
# HELENA_BAMBU_ACCESS_CODE=12345678
# HELENA_BAMBU_SERIAL=00M00A000000000
# HELENA_BAMBU_LAN_ONLY=true

# Where rendered/sliced files are written. Defaults to <workspace>/print3d.
# HELENA_PRINT3D_OUTPUT_DIR=~/print3d-output
