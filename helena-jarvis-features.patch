+  #inputbar input {
+    flex: 1; background: var(--panel); border: 1px solid var(--line); color: var(--text);
+    font-family: inherit; font-size: 14px; padding: 10px 12px; border-radius: 6px; outline: none;
+  }
+  #inputbar input:focus { border-color: var(--cyan-dim); }
