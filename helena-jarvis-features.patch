+<body>
+
+<header>
+  <div class="ring" id="ring"></div>
+  <h1>H.E.L.E.N.A</h1>
+  <div class="meta" id="meta">connecting…</div>
+  <select id="mode">
+    <option value="ask">ask</option>
+    <option value="auto">auto</option>
+    <option value="plan">plan</option>
+    <option value="yolo">yolo</option>
+  </select>
+</header>
+
+<div id="log"></div>
+
+<div id="inputbar">
+  <input id="text" type="text" placeholder="Talk to HELENA…" autofocus>
+  <button id="send">SEND</button>
+</div>
+
+<div id="permission">
+  <div class="card">
+    <h2 id="perm-tool"></h2>
+    <div class="preview" id="perm-preview"></div>
+    <div class="danger" id="perm-danger" style="display:none"></div>
+    <div class="detail" id="perm-detail"></div>
+    <div class="choices">
+      <button data-answer="once">Yes, once</button>
+      <button data-answer="always">Always allow</button>
+      <button data-answer="session">Allow this session</button>
+      <button data-answer="no" class="deny">No</button>
+    </div>
+  </div>
+</div>
+
+<script>
+const log = document.getElementById('log');
+const ring = document.getElementById('ring');
+const meta = document.getElementById('meta');
+const modeSelect = document.getElementById('mode');
+const permission = document.getElementById('permission');
+let assistantLine = null;
+
+function append(html, cls) {
+  const div = document.createElement('div');
+  div.className = 'line ' + (cls || '');
+  div.innerHTML = html;
+  log.appendChild(div);
+  log.scrollTop = log.scrollHeight;
+  return div;
+}
+
+function setRing(state) {
+  ring.className = 'ring ' + state;
+}
+
+const ws = new WebSocket(`ws://${location.host}/ws`);
+
+ws.onopen = () => append('connected — waking HELENA…', 'notice');
+
+ws.onclose = () => { meta.textContent = 'disconnected'; append('connection closed', 'error'); };
+
+modeSelect.onchange = () => ws.send(JSON.stringify({type: 'mode', mode: modeSelect.value}));
+
+ws.onmessage = (evt) => {
+  const msg = JSON.parse(evt.data);
+  switch (msg.type) {
+    case 'ready':
+      meta.textContent = `model ${msg.model} · ${msg.workspace}`;
+      modeSelect.value = msg.mode;
+      setRing('idle');
+      append('online — say what you need.', 'notice');
+      break;
+    case 'notice': append(escapeHtml(msg.text), 'notice'); break;
+    case 'warn': append(escapeHtml(msg.text), 'warn'); break;
+    case 'error': append(escapeHtml(msg.text), 'error'); setRing('idle'); break;
+    case 'assistant_start':
+      assistantLine = append(`<span class="tag">${escapeHtml(msg.label)} </span>`, 'assistant');
+      setRing('speaking');
+      break;
+    case 'token':
+      if (assistantLine) assistantLine.innerHTML += escapeHtml(msg.text).replace(/\n/g, '<br>');
+      log.scrollTop = log.scrollHeight;
+      break;
+    case 'assistant_end':
+      assistantLine = null;
+      break;
+    case 'tool_start':
+      append(`<span class="name">${escapeHtml(msg.tool)}</span> ${escapeHtml(msg.preview)}`, 'tool');
+      break;
+    case 'tool_result':
+      append(`↳ ${escapeHtml(msg.summary || '')}`, msg.ok ? 'tool' : 'tool bad');
+      break;
+    case 'turn_done':
+      setRing('idle');
+      break;
+    case 'permission_request':
+      showPermission(msg);
+      break;
+  }
+};
+
+function showPermission(msg) {
+  document.getElementById('perm-tool').textContent = msg.tool + (msg.agent !== 'helena' ? `  (subagent: ${msg.agent})` : '');
+  document.getElementById('perm-preview').textContent = msg.preview;
+  const dangerEl = document.getElementById('perm-danger');
+  if (msg.danger) { dangerEl.style.display = 'block'; dangerEl.textContent = `⚠ this ${msg.danger}`; }
+  else { dangerEl.style.display = 'none'; }
+  document.getElementById('perm-detail').textContent = msg.detail || '';
+  permission.classList.add('show');
+}
+
+document.querySelectorAll('.choices button').forEach(btn => {
+  btn.onclick = () => {
+    ws.send(JSON.stringify({type: 'permission_answer', answer: btn.dataset.answer}));
+    permission.classList.remove('show');
+  };
+});
+
+function send() {
+  const input = document.getElementById('text');
+  const text = input.value.trim();
+  if (!text) return;
+  append(`<span class="tag">you </span>${escapeHtml(text)}`, 'you');
+  ws.send(JSON.stringify({type: 'message', text}));
+  input.value = '';
+}
+document.getElementById('send').onclick = send;
+document.getElementById('text').addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });
+
+function escapeHtml(s) {
+  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
+}
+</script>
+</body>
+</html>
