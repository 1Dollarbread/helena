+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>H.E.L.E.N.A</title>
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<style>
+  :root {
+    --bg: #05080a;
+    --panel: #0b1418;
+    --line: #123039;
+    --cyan: #4fd8e8;
+    --cyan-dim: #1c5a66;
+    --amber: #e8a94f;
+    --red: #e85f5f;
+    --text: #cfe9ee;
+    --dim: #5f8a92;
+  }
+  * { box-sizing: border-box; }
+  html, body { height: 100%; margin: 0; }
+  body {
+    background: radial-gradient(ellipse at 50% -10%, #0d2229 0%, var(--bg) 60%);
+    color: var(--text);
+    font-family: "SF Mono", "JetBrains Mono", ui-monospace, Menlo, monospace;
+    display: flex;
+    flex-direction: column;
+    height: 100vh;
+    overflow: hidden;
+  }
+  header {
+    display: flex; align-items: center; gap: 16px;
+    padding: 14px 20px;
+    border-bottom: 1px solid var(--line);
+    background: linear-gradient(180deg, #0c1a1f, transparent);
+  }
+  .ring {
+    width: 34px; height: 34px; border-radius: 50%;
+    border: 2px solid var(--cyan-dim);
+    box-shadow: 0 0 0px var(--cyan);
+    transition: box-shadow 0.4s ease, border-color 0.4s ease;
+    flex-shrink: 0;
+  }
+  .ring.thinking { border-color: var(--amber); box-shadow: 0 0 14px var(--amber); animation: pulse 1s infinite; }
+  .ring.speaking { border-color: var(--cyan); box-shadow: 0 0 18px var(--cyan); animation: pulse 0.6s infinite; }
+  .ring.listening { border-color: var(--cyan); box-shadow: 0 0 10px var(--cyan); }
+  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
+  h1 { font-size: 15px; letter-spacing: 0.28em; margin: 0; font-weight: 600; color: var(--cyan); }
+  .meta { font-size: 11px; color: var(--dim); margin-left: auto; text-align: right; line-height: 1.5; }
+  select {
+    background: var(--panel); color: var(--cyan); border: 1px solid var(--line);
+    font-family: inherit; font-size: 11px; padding: 4px 6px; border-radius: 4px;
+  }
+
+  #log { flex: 1; overflow-y: auto; padding: 20px 24px; }
+  .line { margin-bottom: 10px; max-width: 900px; font-size: 13.5px; line-height: 1.55; }
